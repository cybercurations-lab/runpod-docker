# ============================================================
# WanGP — RunPod Docker Image
# ============================================================
# Fixed 2026-09-23 (v3): pip targets Python 3.12 but `python3`
# points to a different interpreter (Ubuntu default 3.10), so
# torch/packages installed to 3.12 were invisible at runtime.
# Fix: resolve pip's interpreter once, use it for installs AND
# runtime. Smoke tests are now FATAL (no || echo swallowing).
#
# Build: GitHub Actions, model=wan-gp, image_tag=wan-gp:v3
# Deploy: image cyber2000/wan-gp:v3, ports ["7860/http"]
# ============================================================

FROM runpod/pytorch:1.3.3-rc.171-cu1281-torch271-ubuntu2204

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV WORKSPACE=/workspace

# ---- System deps ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget curl ffmpeg libgl1-mesa-glx libglib2.0-0 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ---- DIAGNOSTIC: resolve the interpreter pip actually targets ----
RUN echo "=== PYTHON DIAGNOSTIC ===" && \
    echo "python3: $(command -v python3) $(python3 --version 2>&1)" && \
    echo "pip: $(command -v pip) $(pip --version 2>&1)" && \
    PY=$(pip --version 2>&1 | grep -oE 'python[0-9]+\.[0-9]+' | tail -1) && \
    echo "pip's interpreter: $PY" && \
    mkdir -p /workspace && echo "$PY" > /workspace/wangp-python.txt && \
    $PY --version && \
    $PY -c "import sys; print('using', sys.executable)"

# ---- Clone WanGP ----
WORKDIR /workspace
RUN git clone https://github.com/deepbeepmeep/Wan2GP.git /workspace/Wan2GP
WORKDIR /workspace/Wan2GP

# ---- Install requirements with pip's OWN interpreter ----
RUN PY=$(cat /workspace/wangp-python.txt) && \
    echo "Installing requirements with: $PY" && \
    $PY -m pip install --no-cache-dir -r requirements.txt

# ---- Force-reinstall torch MATCHED SET (mismatched torchaudio = ABI crash) ----
RUN PY=$(cat /workspace/wangp-python.txt) && \
    $PY -m pip install --no-cache-dir --force-reinstall \
      torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1 \
      --index-url https://download.pytorch.org/whl/cu128

# ---- FATAL smoke test (imports ALL of torch stack — catches ABI mismatch) ----
RUN PY=$(cat /workspace/wangp-python.txt) && \
    $PY -c "import torch, torchaudio, torchvision, gradio; print('torch:', torch.__version__, '| torchaudio:', torchaudio.__version__, '| torchvision:', torchvision.__version__)"

# Create model + output directories
RUN mkdir -p /workspace/models /workspace/outputs /workspace/config

# ---- Startup script (uses pip's interpreter) ----
COPY start-wangp.sh /workspace/start-wangp.sh
RUN chmod +x /workspace/start-wangp.sh

EXPOSE 7860

WORKDIR /workspace/Wan2GP
ENTRYPOINT ["/workspace/start-wangp.sh"]
